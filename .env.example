# Servidor
PORT=3000
NODE_ENV=development

# Autenticación JWT
JWT_SECRET=tu_clave_secreta_aqui

# Conexión a Base de Datos MySQL
DB_HOST=localhost
DB_PORT=3306
DB_NAME=pos_alalena
DB_USER=root
DB_PASSWORD=
